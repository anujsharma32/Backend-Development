<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Note</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="container">

        <div class="form-container">

            <h1>Add New Note</h1>

            <p>Create a new note for your collection.</p>


            <% if (error) { %>

                <div class="error">
                    <%= error %>
                </div>

            <% } %>


            <form action="/notes" method="POST">

                <label for="title">
                    Title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    placeholder="Enter note title"
                    required
                >


                <label for="content">
                    Content
                </label>

                <textarea
                    id="content"
                    name="content"
                    rows="6"
                    placeholder="Enter note content"
                    required
                ></textarea>


                <label for="category">
                    Category
                </label>

                <input
                    type="text"
                    id="category"
                    name="category"
                    placeholder="e.g. Study, Personal, Work"
                >


                <div class="form-buttons">

                    <button type="submit" class="btn">
                        Add Note
                    </button>

                    <a href="/" class="cancel-btn">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>
</html>